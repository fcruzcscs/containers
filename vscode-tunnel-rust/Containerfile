FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH=/root/.cargo/bin:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        tar \
        git \
        build-essential \
        pkg-config \
        libssl-dev \
        sudo \
        openssh-client \
    && rm -rf /var/lib/apt/lists/*

# Install the standalone VS Code CLI
COPY install-vscode-cli.sh /usr/local/bin/install-vscode-cli.sh
RUN sh /usr/local/bin/install-vscode-cli.sh \
    && rm /usr/local/bin/install-vscode-cli.sh \
    && code --version

# Install Rust
RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --profile minimal --default-toolchain stable \
    && /root/.cargo/bin/rustc --version \
    && /root/.cargo/bin/cargo --version
